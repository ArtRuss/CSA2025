class Stack():
    def __init__(self, size):
        self.max_size = size
        self.occupied = 0
        self.stack_list = []

    def push(self, value):
        #print(f"currently occupied: {self.occupied}\nmax size: {self.max_size}")
        if self.occupied < self.max_size:
            self.stack_list.append(value)
            self.occupied += 1
        else:
            raise IndexError("No room to add to the stack!")
    
    def pop(self):
        if not self.is_empty():
            self.stack_list.remove(self.occupied)
            self.occupied -= 1
        else:
            raise IndexError("Cannot remove from an empty stack!")

    def peek(self):
        if not self.is_empty():
            return self.stack_list[self.occupied-1]
        else:
            raise IndexError("No peeking at an empty list!")

    def get_size(self):
        return self.occupied
    
    def is_empty(self):
        return True if self.occupied == 0 else False

class Queue():
    def __init__(self, max_queue):
        self.queue = []
        self.in_queue = 0
        self.max_queue = max_queue
    
    def dequeue(self):
        if not self.is_empty():
            self.queue.pop(self.in_queue - 1)
            self.in_queue -= 1
        else:
            raise IndexError("Cannot remove from an empty queue")

    def enqueue(self, value):
        if self.in_queue < self.max_queue:
            self.queue.insert(0, value)
            self.in_queue += 1
        else:
            raise IndexError("Cannot add to a full queue!")

    def is_empty(self):
        return True if self.in_queue == 0 else False
    
    def __str__(self):
        return ' '.join(str(value) for value in self.queue)

