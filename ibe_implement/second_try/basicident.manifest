[loader]
argv = [
    "python3",
    "basicident.py",
]
log_level = "error"

[loader.entrypoint]
uri = "file:/usr/lib/x86_64-linux-gnu/gramine/libsysdb.so"
sha256 = "8fb2d369e5d67d4d34100464e1b052d18a421860409f3aeef87a0ed9655a85ac"

[loader.env]
SAGE_ROOT = "/data/sage"
LD_LIBRARY_PATH = "/lib:/usr/lib:/lib64:/usr/lib64:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/data/sage/local/lib"
OMP_NUM_THREADS = "4"
HOME = "/tmp"
PATH = "/bin:/usr/bin:/data/sage"

[libos]
entrypoint = "/data/sage/venv/bin/python3"

[sys]
enable_sigterm_injection = true
enable_extra_runtime_domain_names_conf = true

[sys.stack]
size = "2M"

[fs]
mounts = [
    { path = "/lib", uri = "file:/usr/lib/x86_64-linux-gnu/gramine/runtime/glibc" },
    { path = "/data/sage", uri = "file:/data/sage" },
    { path = "/basicident.py", uri = "file:basicident.py" },
    { path = "/bin", uri = "file:/bin" },
    { path = "/usr/bin", uri = "file:/usr/bin" },
    { path = "/lib64", uri = "file:/lib64" },
    { path = "/usr/lib", uri = "file:/usr/lib" },
    { path = "/usr/lib64", uri = "file:/usr/lib64" },
    { type = "tmpfs", path = "/tmp" },
]

[sgx]
debug = true
enclave_size = "4G"
max_threads = 10
remote_attestation = "none"
file_check_policy = "allow_all_but_log"
isvprodid = 0
isvsvn = 0
enable_stats = false
edmm_enable = false
use_exinfo = false

